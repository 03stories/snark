{
  "manifest_version": 3,
  "name": "Snark",
  "version": "1.4.1",
  "minimum_chrome_version": "121",
  "key": "",
  "description": "Spaces, pinned tabs and nested folders in your side panel. Swipe between workspaces; stale tabs tidy themselves away.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "offscreen",
    "clipboardWrite",
    "scripting",
    "activeTab",
    "sidePanel",
    "contextMenus",
    "favicon",
    "alarms"
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Snark",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "web_accessible_resources": [
    {
      "resources": ["search/*", "core/*", "ui/*", "features/registry.js", "sidepanel/themes.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "copy-url": {
      "suggested_key": { "default": "Ctrl+Shift+C", "mac": "Command+Shift+C" },
      "description": "Copy current tab URL"
    },
    "copy-url-markdown": {
      "description": "Copy current tab as a Markdown link"
    },
    "toggle-sidebar": {
      "suggested_key": { "default": "Ctrl+B", "mac": "Command+B" },
      "description": "Open or close the Snark sidebar"
    },
    "search-snark": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+K" },
      "description": "Search Snark"
    },
    "pin-tab": {
      "description": "Pin current tab into its space"
    },
    "next-space": {
      "description": "Switch to the next space"
    },
    "prev-space": {
      "description": "Switch to the previous space"
    }
  }
}
